# ==============================================================================
# NOVARION ACADEMIC HUB V3 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Aplikasi Web (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Supabase Cloud / Local
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 3. Database PostgreSQL (Drizzle ORM & Worker Connection)
# Gunakan connection string direct PostgreSQL dari Supabase (Port 5432 atau 6543 pooler)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 4. WhatsApp Worker & Baileys Service
# ------------------------------------------------------------------------------
# WA_PROVIDER: Gunakan 'mock' untuk pengujian lokal/staging tanpa WhatsApp asli,
# atau 'baileys' untuk produksi dengan akun WhatsApp nyata.
WA_PROVIDER=mock

# Kunci enkripsi 32-byte (64 karakter hexadecimal) untuk mengenkripsi Signal Keys di PostgreSQL
# Contoh generate di bash/powershell: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WA_SESSION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

WORKER_ID=worker-homelab-01
POLL_INTERVAL_MS=30000

# ------------------------------------------------------------------------------
# 5. Bootstrap Admin Awal (Seed CLI Script)
# ------------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=admin.angkatan@kampus.ac.id
INITIAL_ADMIN_NIM=10241001
INITIAL_ADMIN_NAME="Administrator Angkatan"
